# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/shop2many
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=mydb123

# Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# JWT
JWT_SECRET=YourVeryStrongJWTSecretKey

# Optional: AWS S3 / LocalStack
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_S3_BUCKET=shop2many-bucket
# AWS_REGION=us-east-1
# S3_ENDPOINT=http://localstack:4566

# Application settings
APP_PAGINATION_DEFAULT_PAGE_SIZE=20
APP_PAGINATION_MAX_PAGE_SIZE=100
